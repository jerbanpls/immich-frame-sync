# ---------------------------------------------------------------- Immich
# Base URL of your Immich server (no trailing /api)
IMMICH_URL=http://192.168.1.10:2283
# Account Settings -> API Keys. Needs read access to the album and its assets.
IMMICH_API_KEY=
# The album's UUID, from its URL: .../albums/<IMMICH_ALBUM_ID>
IMMICH_ALBUM_ID=

# ---------------------------------------------------------------- Frame (sk.mimac.slideshow)
# Slideshow -> Settings -> Web server. Include the port if it isn't 80.
FRAME_URL=http://192.168.1.50:8080
FRAME_USER=admin
FRAME_PASS=
# Only change if your Slideshow version serves WebDAV elsewhere
FRAME_WEBDAV_PATH=/webdav/
# Output resolution (landscape)
FRAME_WIDTH=1920
FRAME_HEIGHT=1200
# Files this worker creates start with this; it never touches other files on the frame
FRAME_FILE_PREFIX=immich_

# ---------------------------------------------------------------- Behaviour
SYNC_INTERVAL_MINUTES=15
# true = when a photo is removed from the album, delete it from the frame too
DELETE_FROM_FRAME=false
JPEG_QUALITY=88
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Unraid / Docker
# Host folder for state.json and the processed-JPEG cache
CACHE_DIR=/mnt/user/appdata/immich-frame-sync
PUID=99
PGID=100
